# Copy to asr/.env. docker compose reads it automatically from the asr/ dir.

# Host GPU index for the whole ASR stack (nvidia-smi -L). Default 1 = RTX 5080.
ASR_GPU_ID=1

# Bearer token required by asr-api (except /healthz). Empty = no auth (LAN only).
# Generate: openssl rand -base64 32
ASR_API_TOKEN=

# Host port for the client-facing API (MacBook calls this).
ASR_API_PORT=8090
ASR_API_BIND=0.0.0.0

# Only needed if you switch ASR_MODEL_ID / CLEANUP_MODEL_ID to a gated repo.
HF_TOKEN=

# Knobs for model sizing (fractions of the 5080's 16 GiB).
ASR_GPU_MEM_UTIL=0.42
CLEANUP_GPU_MEM_UTIL=0.45
VLLM_IMAGE=vllm/vllm-openai:latest
