# Copy to .env and fill in values. docker compose reads .env automatically.

# HuggingFace token for pulling gated models (vllm_inference).
HF_TOKEN=

# API key for the vLLM server, if enabled (openwebui).
VLLM_API_KEY=

# LiteLLM proxy keys — generate long random values, e.g.:
#   openssl rand -base64 32
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# stealthy-auto-browse (Camoufox private browsing for agents). Bearer token
# required by the browser API/MCP endpoints (except /health).
BROWSER_AUTH_TOKEN=
