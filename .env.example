# Copy to .env and fill in values. docker compose reads .env automatically.

# HuggingFace token for pulling gated models (ASR stack).
HF_TOKEN=

# stealthy-auto-browse (Camoufox private browsing for agents). Bearer token
# required by the browser API/MCP endpoints (except /health).
BROWSER_AUTH_TOKEN=

# --- ASR stack (services/asr) -------------------------------------------------

# Host GPU index for the whole ASR stack (nvidia-smi -L). Default 1 = RTX 5080.
ASR_GPU_ID=1

# Bearer token required by asr-api (except /healthz). Empty = no auth (LAN only).
# Generate: openssl rand -base64 32
ASR_API_TOKEN=

# Host port for the client-facing API (MacBook calls this).
ASR_API_PORT=8090
ASR_API_BIND=0.0.0.0

# Knobs for model sizing (fractions of the 5080's 16 GiB).
ASR_GPU_MEM_UTIL=0.42
CLEANUP_GPU_MEM_UTIL=0.2
VLLM_IMAGE=vllm/vllm-openai:latest

# s1-mini control-line register: casual | semi-casual | semi-formal | formal
CLEANUP_STYLING=semi-formal
