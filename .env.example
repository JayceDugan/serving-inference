# Copy to .env and fill in values. docker compose reads .env automatically.

# HuggingFace token for pulling gated models (ASR stack).
HF_TOKEN=

# stealthy-auto-browse (Camoufox private browsing for agents). Bearer token
# required by the browser API/MCP endpoints (except /health).
BROWSER_AUTH_TOKEN=

# --- ASR stack (services/asr) -------------------------------------------------

# Host GPU index for the whole ASR stack (nvidia-smi -L). Default 1 = RTX 5080.
ASR_GPU_ID=1

# Bearer token required by asr-api (except /healthz). Empty = no auth (LAN only).
# Generate: openssl rand -base64 32
ASR_API_TOKEN=

# Host port for the client-facing API (MacBook calls this).
ASR_API_PORT=8090
ASR_API_BIND=0.0.0.0

# Knobs for model sizing (fractions of the 5080's 16 GiB).
ASR_GPU_MEM_UTIL=0.42
CLEANUP_GPU_MEM_UTIL=0.2
VLLM_IMAGE=vllm/vllm-openai:latest

# s1-mini control-line register: casual | semi-casual | semi-formal | formal
CLEANUP_STYLING=semi-formal

# Kokoro TTS (kokoro-model): 'a' = American English, 'b' = British English.
# One pipeline per process; voices must match the language prefix.
KOKORO_LANG_CODE=a
# Voice used by /v1/speak when the request omits one (hexgrad/Kokoro-82M).
KOKORO_DEFAULT_VOICE=af_heart

# --- Langfuse (services/langfuse submodule) ----------------------------------
# LLM observability on :3000. Generate each secret once, then never change
# SALT / ENCRYPTION_KEY — API keys and encrypted payloads become unreadable.
#   openssl rand -hex 16        # SALT, NEXTAUTH_SECRET, *_PASSWORD, REDIS_AUTH
#   openssl rand -hex 32        # ENCRYPTION_KEY (must be 64 hex chars)
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
TELEMETRY_ENABLED=false

# Postgres backing Langfuse. DATABASE_URL must carry the same password:
#   postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/postgres
POSTGRES_PASSWORD=
DATABASE_URL=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=

# MinIO (S3 for events/media). The three S3 secrets must match MINIO_ROOT_PASSWORD.
MINIO_ROOT_PASSWORD=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=

# One-time bootstrap on first start: creates the org, project, login, and an
# API key pair. Keys follow the pk-lf-<uuid> / sk-lf-<uuid> convention.
LANGFUSE_INIT_ORG_ID=ai-lab
LANGFUSE_INIT_ORG_NAME=ai-lab
LANGFUSE_INIT_PROJECT_ID=ai-lab
LANGFUSE_INIT_PROJECT_NAME=ai-lab
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-...
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-...
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
